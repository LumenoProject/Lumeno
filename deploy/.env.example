# Pin a vX.X.X tag or digest in production.
LUMENO_IMAGE=ghcr.io/lumenoproject/lumeno:latest

POSTGRES_DB=lumeno
POSTGRES_USER=lumeno
POSTGRES_PASSWORD=replace-with-a-long-url-safe-random-password

# Optional: set this to use an external PostgreSQL database.
# When omitted, Lumeno connects to the bundled db service using the POSTGRES_* values above.
# DATABASE_URL=postgresql://user:password@postgres.example.com:5432/lumeno

LUMENO_DOMAIN=focus.example.com
LUMENO_PUBLIC_URL=https://focus.example.com/

OIDC_ISSUER=https://id.example.com
OIDC_CLIENT_ID=replace-with-zitadel-client-id
OIDC_CLIENT_SECRET=replace-with-zitadel-client-secret
# Leave empty to accept provider audience IDs while still requiring azp to match the Client ID.
# Set a comma-separated list to enforce a strict allowlist for non-Client-ID audiences.
OIDC_TRUSTED_AUDIENCES=

SESSION_IDLE_SECONDS=604800
SESSION_ABSOLUTE_SECONDS=2592000

# Server-side master key used only to encrypt stored Bark/Webhook credentials.
# This is not a Bark device encryption key. Base64URL-encoded, 32 bytes after decoding.
# Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
NOTIFICATION_ENCRYPTION_KEY=replace-with-a-generated-key
# Comma-separated HTTPS origins allowed as notification targets. All other origins are rejected.
# Do not include a Bark device key or any path. Add more origins only when you trust them.
NOTIFICATION_ENDPOINT_ALLOWLIST=https://api.day.app
